NODE_ENV=production
PORT=3000

# Use your managed PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate long random secrets. Never commit these values.
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m

# Comma-separated production frontend origins.
FRONTEND_URL=https://tykstore.com

CORS_ORIGINS=https://tykstore.com,https://www.tykstore.com


# Optional AI integration.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna

# Optional Stripe integration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
