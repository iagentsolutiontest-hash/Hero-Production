NODE_ENV=production
PORT=3000

# Use your managed PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Local test database for Jest. This is optional when a real TEST_DATABASE_URL is set.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hero_test

# Pool and timeout tuning for production-grade DB reuse.
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=15000

# Private Supabase Storage bucket for Files and Receipts uploads.
# Create a private bucket named hero-files (or set a different bucket below).
# Keep the service-role key only in the backend environment.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=hero-files

# Generate long random secrets. Never commit these values.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL=15m

# Comma-separated production frontend origins.
CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app

# Optional AI integration.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna

# Optional Stripe integration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=


# Hero Accounting subscription
SUBSCRIPTION_PRICE=50
SUBSCRIPTION_CURRENCY=USD
STRIPE_PRICE_ID=

# Private document storage. Supabase is preferred for production; local storage is the fallback.
DOCUMENT_STORAGE_DIR=./storage/documents
