{
  "name": "hero-backend",
  "version": "1.0.0",
  "description": "Hero accounting platform — NestJS + PostgreSQL API (Phase 1)",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "start": "ts-node --transpile-only src/main.ts",
    "start:dev": "ts-node --transpile-only --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "ts-node --transpile-only src/db/migrate.ts",
    "seed": "ts-node --transpile-only src/db/seed/systemRolesAndPermissions.ts",
    "test": "jest --config jest.config.js",
    "start:prod": "node dist/main.js"
  },
