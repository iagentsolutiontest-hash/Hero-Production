{
"compilerOptions": {
"module": "commonjs",
"target": "ES2022",
"moduleResolution": "node",
"outDir": "./dist",
"rootDir": "./src",
"sourceMap": true,
"declaration": false,
"removeComments": false,
"allowSyntheticDefaultImports": true,
"esModuleInterop": true,
"emitDecoratorMetadata": true,
"experimentalDecorators": true,
"strict": false,
"skipLibCheck": true,
"forceConsistentCasingInFileNames": true
},
"include": [
"src/**/*.ts"
],
"exclude": [
"node_modules",
"dist",
"test",
"**/*.spec.ts",
"**/*.test.ts"
]
}
